#!/bin/sh
# Bump VERSION (1.x -> 1.x+1) on every commit on main. The first commit stays 1.0.
# The new version is derived from HEAD:VERSION, not the working tree, so
# re-running after an aborted commit does not bump twice.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
[ "$branch" = "main" ] || exit 0

# Root commit: nothing to bump.
git rev-parse --verify --quiet HEAD >/dev/null || exit 0

current=$(git show HEAD:VERSION 2>/dev/null | tr -d '[:space:]')
case "$current" in
    [0-9]*.[0-9]*) ;;
    *) current="" ;;
esac
major=${current%%.*}
minor=${current#*.}
case "$major$minor" in
    ""|*[!0-9]*)
        echo "pre-commit: HEAD:VERSION must look like <major>.<minor>, got '$current'" >&2
        exit 1
        ;;
esac

printf '%s.%s\n' "$major" "$((minor + 1))" > VERSION
git add VERSION
